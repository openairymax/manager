# =============================================================================
# AgentRT Manager Module - Git Ignore Configuration
# 版本: 0.1.1
# 策略：非必要不追踪。仅忽略本地构建产物、缓存与运行时数据，
#       源码与必要配置保持可追踪，避免误推远程仓库
# Part of Airymax open-source project (agentrt)
# =============================================================================

# ---------- Python 缓存 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# ---------- 打包与分发 ----------
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer 日志
pip-log.txt
pip-delete-this-directory.txt

# ---------- 测试与覆盖率 ----------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
test-results/
test_output/

# ---------- 虚拟环境 ----------
.env
.env.*
!.env.example
.venv
env/
venv/
ENV/

# ---------- IDE 与编辑器配置 ----------
.idea/
.vscode/
.trae/
*.code-workspace
*.swp
*.swo
*~

# ---------- 项目特有 ----------
.baseline/
drift_report.json
drift_report.md
audit_output_*.json

# ---------- 运行时数据 ----------
*.log
*.sock
*.db
*.tmp
*.bak

# ---------- 操作系统文件 ----------
.DS_Store
Thumbs.db
Desktop.ini
